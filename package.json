{
  "name": "telemedicina-dicom-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web platform for DICOM medical imaging upload, lossless download, workstation visualization, and remote diagnosis",
  "scripts": {
    "dev:client": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "preview": "npm run build && wrangler dev --port 8787",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 execute telemedicina-dicom-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute telemedicina-dicom-db --remote --file=./migrations/0001_init.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "dicom-parser": "^1.8.21",
    "hono": "^4.7.4",
    "lucide-react": "^0.487.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@tailwindcss/vite": "^4.0.15",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9",
    "wrangler": "^4.4.0"
  }
}
